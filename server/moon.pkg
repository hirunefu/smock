import {
  "smock/grpc",
  "smock/http1",
  "smock/protobuf",
  "smock/smock/buildinfo",
  "smock/smock/defdir",
  "smock/smock/definitions",
  "smock/smock/engine",
  "smock/smock/log",
  "smock/smock/metrics",
  "smock/smock/openssl",
  "smock/smock/prng",
  "smock/smock/serverparsers",
  "smock/smock/settings",
  "smock/smock/template",
  "smock/smock/usage",
  "smock/smock/watch",
  "moonbitlang/async",
  "moonbitlang/async/cond_var",
  "moonbitlang/async/fs",
  "moonbitlang/async/io",
  "moonbitlang/async/os_error",
  "moonbitlang/async/process",
  "moonbitlang/async/signal",
  "moonbitlang/async/socket",
  "moonbitlang/async/stdio",
  "moonbitlang/core/bench",
  "moonbitlang/core/buffer",
  "moonbitlang/core/deque",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/encoding/percent",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitstack/moonhttp/header",
  "moonbitstack/moonhttp/http2",
}

supported_targets = "native"

import {
  "smock/smock/testcerts",
  "moonbitlang/core/string",
} for "wbtest"

// The async tests run one at a time, not ten. Two of them measure the
// resident memory of the whole test process, which any test running
// beside them grows: the first certificate pair a process loads grows it
// by about 5 MiB, most of it OpenSSL's libraries read in (#427).

max_concurrent_tests = 1

options(
  "native-stub": [ "reset.c" ],
)
