// Paths with parameters: each becomes a pattern, and operations are sorted
// so that a concrete path comes before a templated one.

///|
test "a path with parameters becomes a pattern in which each parameter matches one segment, and a concrete path comes before a templated one" {
  inspect(
    import_to(
      (
        #|{
        #|  "openapi": "3.1.0",
        #|  "info": { "title": "Petstore", "version": "1.0.0" },
        #|  "paths": {
        #|    "/pets/{petId}": {
        #|      "get": { "operationId": "getPetById", "responses": { "200": {} } }
        #|    },
        #|    "/pets/mine": {
        #|      "get": { "operationId": "getMyPet", "responses": { "200": {} } }
        #|    },
        #|    "/files/{name}.json": {
        #|      "get": { "operationId": "getFile", "responses": { "200": {} } }
        #|    }
        #|  }
        #|}
      ),
    ),
    content=(
      #|3 Stubs from 3 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (Petstore 1.0.0, OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|version: 1
      #|mocks:
      #|  - name: petstore
      #|stubs:
      #|  # GET /pets/mine, 200
      #|  - id: petstore.getMyPet.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /pets/mine
      #|    response:
      #|      status: 200
      #|  # GET /files/{name}.json, 200
      #|  - id: petstore.getFile.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path:
      #|        pattern: /files/[^/]+\.json
      #|    response:
      #|      status: 200
      #|  # GET /pets/{petId}, 200
      #|  - id: petstore.getPetById.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path:
      #|        pattern: /pets/[^/]+
      #|    response:
      #|      status: 200
      #|
    ),
  )
}

///|
test "literal text is percent-decoded, then its ASCII punctuation other than / is escaped with a backslash; several parameters may share a segment" {
  // The paths are written in the order they sort in, so that the file
  // keeps the document's order.
  inspect(
    stubs_of(
      with_paths(
        (
          #|{
          #|  "/a%2Fb/{id}": { "get": { "responses": { "200": {} } } },
          #|  "/x/!$&'()*+,;=:@-_.~%5B%5D%5E%60%7B%7D%7C%22%25%3F%23%3C%3E%5C/{id}": { "get": { "responses": { "200": {} } } },
          #|  "/caf%C3%A9/a%20b%zz/{id}": { "get": { "responses": { "200": {} } } },
          #|  "/files/{name}.{ext}": { "get": { "responses": { "200": {} } } },
          #|  "/v1.0/{id}~{rev}": { "get": { "responses": { "200": {} } } },
          #|  "/{a}{b}": { "get": { "responses": { "200": {} } } }
          #|}
        ),
      ),
    ),
    content=(
      #|petstore.GET /a%2Fb/{id}.200: GET pattern /a/b/[^/]+ -> 200
      #|petstore.GET /x/!$&'()*+,;=:@-_.~%5B%5D%5E%60%7B%7D%7C%22%25%3F%23%3C%3E%5C/{id}.200: GET pattern /x/\!\$\&\'\(\)\*\+\,\;\=\:\@\-\_\.\~\[\]\^\`\{\}\|\"\%\?\#\<\>\\/[^/]+ -> 200
      #|petstore.GET /caf%C3%A9/a%20b%zz/{id}.200: GET pattern /café/a b\%zz/[^/]+ -> 200
      #|petstore.GET /files/{name}.{ext}.200: GET pattern /files/[^/]+\.[^/]+ -> 200
      #|petstore.GET /v1.0/{id}~{rev}.200: GET pattern /v1\.0/[^/]+\~[^/]+ -> 200
      #|petstore.GET /{a}{b}.200: GET pattern /[^/]+[^/]+ -> 200
      #|
    ),
  )
}

///|
test "operations are sorted segment by segment: literal, then mixed, then one parameter; a shorter path comes first when its kinds are a prefix; ties keep the document's order, and problems follow the document" {
  inspect(
    stubs_of(
      with_paths(
        (
          #|{
          #|  "/pets/{petId}/toys": { "get": { "operationId": "listToys", "responses": { "200": {} } } },
          #|  "/pets/{petId}": {
          #|    "get": {
          #|      "operationId": "getPet",
          #|      "callbacks": { "onChange": {} },
          #|      "responses": { "404": {}, "200": {} }
          #|    },
          #|    "delete": { "operationId": "deletePet", "responses": { "204": {} } }
          #|  },
          #|  "/{tenant}/pets": { "get": { "operationId": "tenantPets", "responses": { "200": {} } } },
          #|  "/users/me": { "get": { "operationId": "getMe", "responses": { "200": {} } } },
          #|  "/pets/mine": {
          #|    "get": { "operationId": "getMyPet", "callbacks": { "onChange": {} }, "responses": { "200": {} } }
          #|  },
          #|  "/pets/{petId}.json": { "get": { "operationId": "getPetJson", "responses": { "200": {} } } },
          #|  "/": { "get": { "operationId": "root", "responses": { "200": {} } } },
          #|  "/pets": {
          #|    "get": { "operationId": "listPets", "responses": { "200": {} } },
          #|    "put": { "operationId": "replacePets", "responses": { "200": {} } }
          #|  },
          #|  "/pets/mine/toys": { "get": { "operationId": "myToys", "responses": { "200": {} } } }
          #|}
        ),
      ),
    ),
    content=(
      #|petstore.json: /paths/~1pets~1{petId}/get/callbacks: warning: callbacks are not imported
      #|petstore.json: /paths/~1pets~1mine/get/callbacks: warning: callbacks are not imported
      #|petstore.root.200: GET / -> 200
      #|petstore.listPets.200: GET /pets -> 200
      #|petstore.replacePets.200: PUT /pets -> 200
      #|petstore.getMe.200: GET /users/me -> 200
      #|petstore.getMyPet.200: GET /pets/mine -> 200
      #|petstore.myToys.200: GET /pets/mine/toys -> 200
      #|petstore.getPetJson.200: GET pattern /pets/[^/]+\.json -> 200
      #|petstore.getPet.404: GET pattern /pets/[^/]+ -> 404
      #|petstore.getPet.200: GET pattern /pets/[^/]+ -> 200
      #|petstore.deletePet.204: DELETE pattern /pets/[^/]+ -> 204
      #|petstore.listToys.200: GET pattern /pets/[^/]+/toys -> 200
      #|petstore.tenantPets.200: GET pattern /[^/]+/pets -> 200
      #|
    ),
  )
}

///|
test "when two operations' method and path give the same pattern, the first in document order is kept and the later one is left out with a warning; an exact path is never the same as a pattern" {
  inspect(
    stubs_of(
      with_paths(
        (
          #|{
          #|  "/pets/{petId}": { "get": { "operationId": "getPet", "responses": { "200": {} } } },
          #|  "/pets/{id}": {
          #|    "get": { "operationId": "getPetToo", "responses": { "200": {} } },
          #|    "delete": { "operationId": "deletePet", "responses": { "204": {} } }
          #|  },
          #|  "/pets/[^/]+": { "get": { "operationId": "literal", "responses": { "200": {} } } },
          #|  "/files/{a}.json": { "get": { "operationId": "getFile", "responses": { "200": {} } } },
          #|  "/files/{b}.json": { "get": { "operationId": "getFileToo", "responses": { "200": {} } } },
          #|  "/a%2Fb/{id}": { "get": { "responses": { "200": {} } } },
          #|  "/a/b/{x}": { "get": { "responses": { "200": {} } } }
          #|}
        ),
      ),
    ),
    content=(
      #|petstore.json: /paths/~1pets~1{id}/get: warning: left out: GET with the path pattern "/pets/[^/]+" is already answered by the operation at petstore.json: /paths/~1pets~1{petId}/get, which comes first
      #|petstore.json: /paths/~1files~1{b}.json/get: warning: left out: GET with the path pattern "/files/[^/]+\\.json" is already answered by the operation at petstore.json: /paths/~1files~1{a}.json/get, which comes first
      #|petstore.json: /paths/~1a~1b~1{x}/get: warning: left out: GET with the path pattern "/a/b/[^/]+" is already answered by the operation at petstore.json: /paths/~1a%2Fb~1{id}/get, which comes first
      #|petstore.literal.200: GET /pets/[^/]+ -> 200
      #|petstore.GET /a%2Fb/{id}.200: GET pattern /a/b/[^/]+ -> 200
      #|petstore.getFile.200: GET pattern /files/[^/]+\.json -> 200
      #|petstore.getPet.200: GET pattern /pets/[^/]+ -> 200
      #|petstore.deletePet.204: DELETE pattern /pets/[^/]+ -> 204
      #|
    ),
  )
}

///|
test "two patterns that can match the same request keep the document's order, with no warning" {
  inspect(
    stubs_of(
      with_paths(
        (
          #|{
          #|  "/files/{name}.{ext}": { "get": { "operationId": "getAnyFile", "responses": { "200": {} } } },
          #|  "/files/{name}.json": { "get": { "operationId": "getJsonFile", "responses": { "200": {} } } }
          #|}
        ),
      ),
    ),
    content=(
      #|petstore.getAnyFile.200: GET pattern /files/[^/]+\.[^/]+ -> 200
      #|petstore.getJsonFile.200: GET pattern /files/[^/]+\.json -> 200
      #|
    ),
  )
}

///|
test "decoded text that is not ASCII punctuation, control characters included, is written in a pattern as it is" {
  inspect(
    import_json(
      with_paths(
        (
          #|{ "/a%0A%09b/{id}": { "get": { "operationId": "a", "responses": { "200": {} } } } }
        ),
      ),
    ),
    content=(
      #|1 Stubs from 1 operations
      #|{
      #|  "version": 1,
      #|  "mocks": [
      #|    {
      #|      "name": "petstore"
      #|    }
      #|  ],
      #|  "stubs": [
      #|    {
      #|      "id": "petstore.a.200",
      #|      "mock": "petstore",
      #|      "request": {
      #|        "method": "GET",
      #|        "path": {
      #|          "pattern": "/a\n\tb/[^/]+"
      #|        }
      #|      },
      #|      "response": {
      #|        "status": 200
      #|      }
      #|    }
      #|  ]
      #|}
      #|
    ),
  )
}
