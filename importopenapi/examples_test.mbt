// Bodies from the document's examples: a media type's `examples`, whose
// first is the response's body and whose others get Stubs of their own,
// selected by the header `Smock-Example`; then its `example`; then the
// schema.

///|
/// Converts a document of the OpenAPI version `openapi` whose only
/// operation is `GET /r`, with the Responses Object `responses`, given as
/// JSON text, into a YAML file, and renders its problems, one per line,
/// then its Stubs as the file writes them, with their comments, or
/// `nothing written`.
fn examples_of(responses : String, openapi~ : String = "3.2.0") -> String {
  let document = "{ \"openapi\": \"\{openapi}\", \"paths\": { \"/r\": { \"get\": { \"operationId\": \"r\", \"responses\": \{responses} } } } }"
  let conversion = @importopenapi.convert(
    [("petstore.json", @utf8.encode(document))],
    @importopenapi.Options(
      root="petstore.json",
      mock="petstore",
      output="defs/petstore.yaml",
    ),
  )
  let out = StringBuilder()
  for problem in conversion.problems() {
    out.write_string(problem.to_string())
    out.write_char('\n')
  }
  guard conversion is Converted(file~, ..) else {
    out.write_string("nothing written\n")
    return out.to_string()
  }
  // The comment at the top, `version`, `mocks` and `stubs:` are the same
  // in every file.
  let file = @utf8.decode_lossy(file)
  if file.find("stubs:\n") is Some(i) {
    out.write_string(file[i + "stubs:\n".length():].to_owned())
  }
  out.to_string()
}

///|
test "a media type's first named example is the response's body, and the Stub's comment names it" {
  inspect(
    examples_of(
      (
        #|{
        #|  "200": {
        #|    "content": {
        #|      "application/json": {
        #|        "schema": { "type": "object", "properties": { "name": { "type": "string" } } },
        #|        "examples": { "cat": { "value": { "name": "Tom" } } }
        #|      }
        #|    }
        #|  }
        #|}
      ),
    ),
    content=(
      #|  # GET /r, 200, example cat
      #|  - id: petstore.r.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|    response:
      #|      status: 200
      #|      json:
      #|        name: Tom
      #|
    ),
  )
}

///|
test "every further named example gets a Stub selected by Smock-Example, after Smock-Status for another response's; the Stubs come in the order the spec gives, so that none is shadowed" {
  inspect(
    import_to(
      (
        #|{
        #|  "openapi": "3.1.0",
        #|  "info": { "title": "Petstore", "version": "1.0.0" },
        #|  "paths": {
        #|    "/pets/mine": {
        #|      "get": {
        #|        "operationId": "getPet",
        #|        "summary": "Find my pet",
        #|        "responses": {
        #|          "200": {
        #|            "content": {
        #|              "application/json": {
        #|                "examples": {
        #|                  "cat": { "value": { "name": "Tom" } },
        #|                  "dog": { "value": { "name": "Rex" } }
        #|                }
        #|              }
        #|            }
        #|          },
        #|          "404": {
        #|            "content": {
        #|              "application/json": {
        #|                "examples": {
        #|                  "missing": { "value": { "message": "Pet not found" } },
        #|                  "gone": { "value": { "message": "Pet gone" } }
        #|                }
        #|              }
        #|            }
        #|          }
        #|        }
        #|      }
        #|    }
        #|  }
        #|}
      ),
    ),
    content=(
      #|4 Stubs from 1 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (Petstore 1.0.0, OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|version: 1
      #|mocks:
      #|  - name: petstore
      #|stubs:
      #|  # GET /pets/mine, 404, example gone: Find my pet
      #|  - id: petstore.getPet.404.gone
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /pets/mine
      #|      headers:
      #|        Smock-Status: "404"
      #|        Smock-Example: gone
      #|    response:
      #|      status: 404
      #|      json:
      #|        message: Pet gone
      #|  # GET /pets/mine, 404, example missing: Find my pet
      #|  - id: petstore.getPet.404
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /pets/mine
      #|      headers:
      #|        Smock-Status: "404"
      #|    response:
      #|      status: 404
      #|      json:
      #|        message: Pet not found
      #|  # GET /pets/mine, 200, example dog: Find my pet
      #|  - id: petstore.getPet.200.dog
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /pets/mine
      #|      headers:
      #|        Smock-Example: dog
      #|    response:
      #|      status: 200
      #|      json:
      #|        name: Rex
      #|  # GET /pets/mine, 200, example cat: Find my pet
      #|  - id: petstore.getPet.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /pets/mine
      #|    response:
      #|      status: 200
      #|      json:
      #|        name: Tom
      #|
    ),
  )
}

///|
/// The Stubs of the file that converting one `GET /r` operation of the
/// OpenAPI version `openapi`, with the Responses Object `responses`, given
/// as JSON text, gives, one per line after the problems: the ID, the
/// selector headers the request must send, if any, the status, and the
/// `json` or `body`, if any.
fn selectors_of(
  responses : String,
  openapi~ : String = "3.2.0",
) -> String raise {
  let document = "{ \"openapi\": \"\{openapi}\", \"paths\": { \"/r\": { \"get\": { \"operationId\": \"r\", \"responses\": \{responses} } } } }"
  let conversion = @importopenapi.convert(
    [("petstore.json", @utf8.encode(document))],
    @importopenapi.Options(
      root="petstore.json",
      mock="petstore",
      output="defs/petstore.json",
    ),
  )
  let out = StringBuilder()
  for problem in conversion.problems() {
    out.write_string(problem.to_string())
    out.write_char('\n')
  }
  guard conversion is Converted(file~, ..) else {
    out.write_string("nothing written\n")
    return out.to_string()
  }
  guard @json.parse(@utf8.decode(file)) is Object({ "stubs": Array(stubs), .. }) else {
    fail("the file has no stubs")
  }
  for stub in stubs {
    guard stub
      is Object(
        {
          "id": String(id),
          "request": Object(request),
          "response": Object({ "status": Number(status, ..), .. } as response),
          ..
        }
      ) else {
      fail("unexpected Stub: \{stub.stringify()}")
    }
    let body = match response {
      { "json": json, .. } => " json \{json.stringify()}"
      { "body": String(text), .. } => " body \{text.escape()}"
      _ => ""
    }
    let selectors = []
    if request.get("headers") is Some(Object(headers)) {
      for name, value in headers {
        guard value is String(value) else {
          fail("unexpected header: \{value.stringify()}")
        }
        selectors.push("\{name}: \{value}")
      }
    }
    out.write_string("\{id}: [\{selectors.join(", ")}] -> \{status}\{body}\n")
  }
  out.to_string()
}

///|
test "within an operation: the other responses' further named examples, then the other responses, then the main response's further named examples, then the main Stub, each in the order the document writes them" {
  inspect(
    selectors_of(
      (
        #|{
        #|  "404": { "content": { "application/json": { "examples": { "a": { "value": 1 }, "b": { "value": 2 }, "c": { "value": 3 } } } } },
        #|  "200": { "content": { "application/json": { "examples": { "d": { "value": 4 }, "e": { "value": 5 } } } } },
        #|  "default": { "content": { "application/json": { "examples": { "f": { "value": 6 }, "g": { "value": 7 } } } } },
        #|  "500": { "content": { "application/json": { "example": 8 } } }
        #|}
      ),
    ),
    content=(
      #|petstore.r.404.b: [Smock-Status: 404, Smock-Example: b] -> 404 json 2
      #|petstore.r.404.c: [Smock-Status: 404, Smock-Example: c] -> 404 json 3
      #|petstore.r.default.g: [Smock-Status: default, Smock-Example: g] -> 500 json 7
      #|petstore.r.404: [Smock-Status: 404] -> 404 json 1
      #|petstore.r.default: [Smock-Status: default] -> 500 json 6
      #|petstore.r.500: [Smock-Status: 500] -> 500 json 8
      #|petstore.r.200.e: [Smock-Example: e] -> 200 json 5
      #|petstore.r.200: [] -> 200 json 4
      #|
    ),
  )
}

///|
test "the sources, in order: the media type's examples, its example, then its schema; with both example and examples, examples is used, with a warning" {
  inspect(
    examples_of(
      (
        #|{
        #|  "201": {
        #|    "content": {
        #|      "application/json": {
        #|        "example": "from example",
        #|        "schema": { "const": "from the schema" },
        #|        "examples": { "e": { "value": "from examples" } }
        #|      }
        #|    }
        #|  },
        #|  "202": {
        #|    "content": {
        #|      "application/json": {
        #|        "schema": { "const": "from the schema", "example": "from the schema's example" },
        #|        "example": "from example"
        #|      }
        #|    }
        #|  },
        #|  "203": { "content": { "application/json": { "schema": { "example": "from the schema's example" } } } },
        #|  "200": { "content": { "application/json": { "examples": {}, "example": "from example" } } }
        #|}
      ),
    ),
    content=(
      #|petstore.json: /paths/~1r/get/responses/201/content/application~1json/example: warning: ignored: the media type has examples, which come first
      #|  # GET /r, 201, example e
      #|  - id: petstore.r.201
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "201"
      #|    response:
      #|      status: 201
      #|      json: from examples
      #|  # GET /r, 202
      #|  - id: petstore.r.202
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "202"
      #|    response:
      #|      status: 202
      #|      json: from example
      #|  # GET /r, 203
      #|  - id: petstore.r.203
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "203"
      #|    response:
      #|      status: 203
      #|      json: from the schema's example
      #|  # GET /r, 200
      #|  - id: petstore.r.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|    response:
      #|      status: 200
      #|      json: from example
      #|
    ),
  )
}

///|
test "from an Example Object, a JSON media type takes dataValue, else value, else a serializedValue, which is written as body with its Content-Type; another media type takes serializedValue, else dataValue, else value" {
  inspect(
    examples_of(
      (
        #|{
        #|  "201": { "content": { "application/json": { "examples": { "e": { "dataValue": { "a": 1 }, "value": { "a": 2 }, "serializedValue": "{\"a\": 3}" } } } } },
        #|  "202": { "content": { "application/json": { "examples": { "e": { "value": { "a": 2 }, "serializedValue": "{\"a\": 3}" } } } } },
        #|  "203": { "content": { "application/json": { "examples": { "e": { "serializedValue": "{\"a\": 3.10}" } } } } },
        #|  "206": { "content": { "application/problem+json": { "examples": { "e": { "serializedValue": "{\"title\": \"x\"}" } } } } },
        #|  "207": { "content": { "text/plain": { "examples": { "e": { "dataValue": "data", "value": "value", "serializedValue": "serialized" } } } } },
        #|  "208": { "content": { "text/plain": { "examples": { "e": { "dataValue": "data", "value": "value" } } } } },
        #|  "209": { "content": { "text/csv": { "examples": { "e": { "value": "a,b\n1,2\n" } } } } },
        #|  "210": { "content": { "text/plain": { "examples": { "e": { "value": 4.50 } } } } },
        #|  "211": { "content": { "text/plain": { "examples": { "e": { "value": { "a": 1 } } } } } },
        #|  "212": { "content": { "*/*": { "examples": { "e": { "value": { "a": 1 } } } } } },
        #|  "213": { "content": { "*/*": { "examples": { "e": { "serializedValue": "{\"a\":1}", "value": { "a": 1 } } } } } },
        #|  "200": { "content": { "application/json": { "examples": { "e": { "value": "a string" } } } } }
        #|}
      ),
    ),
    content=(
      #|petstore.json: /paths/~1r/get/responses/211/content/text~1plain/examples/e/value: warning: left out: the body is empty, since a "text/plain" body cannot hold an object
      #|  # GET /r, 201, example e
      #|  - id: petstore.r.201
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "201"
      #|    response:
      #|      status: 201
      #|      json:
      #|        a: 1
      #|  # GET /r, 202, example e
      #|  - id: petstore.r.202
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "202"
      #|    response:
      #|      status: 202
      #|      json:
      #|        a: 2
      #|  # GET /r, 203, example e
      #|  - id: petstore.r.203
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "203"
      #|    response:
      #|      status: 203
      #|      headers:
      #|        Content-Type: application/json
      #|      body: "{\"a\": 3.10}"
      #|  # GET /r, 206, example e
      #|  - id: petstore.r.206
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "206"
      #|    response:
      #|      status: 206
      #|      headers:
      #|        Content-Type: application/problem+json
      #|      body: "{\"title\": \"x\"}"
      #|  # GET /r, 207, example e
      #|  - id: petstore.r.207
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "207"
      #|    response:
      #|      status: 207
      #|      headers:
      #|        Content-Type: text/plain
      #|      body: serialized
      #|  # GET /r, 208, example e
      #|  - id: petstore.r.208
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "208"
      #|    response:
      #|      status: 208
      #|      headers:
      #|        Content-Type: text/plain
      #|      body: data
      #|  # GET /r, 209, example e
      #|  - id: petstore.r.209
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "209"
      #|    response:
      #|      status: 209
      #|      headers:
      #|        Content-Type: text/csv
      #|      body: "a,b\n1,2\n"
      #|  # GET /r, 210, example e
      #|  - id: petstore.r.210
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "210"
      #|    response:
      #|      status: 210
      #|      headers:
      #|        Content-Type: text/plain
      #|      body: "4.5"
      #|  # GET /r, 211, example e
      #|  - id: petstore.r.211
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "211"
      #|    response:
      #|      status: 211
      #|      headers:
      #|        Content-Type: text/plain
      #|  # GET /r, 212, example e
      #|  - id: petstore.r.212
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "212"
      #|    response:
      #|      status: 212
      #|      json:
      #|        a: 1
      #|  # GET /r, 213, example e
      #|  - id: petstore.r.213
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "213"
      #|    response:
      #|      status: 213
      #|      body: "{\"a\":1}"
      #|  # GET /r, 200, example e
      #|  - id: petstore.r.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|    response:
      #|      status: 200
      #|      json: a string
      #|
    ),
  )
}

///|
test "an Example Object with only externalValue, which is not read, or with no value is left out, with a warning; the others keep their order, and when none is left, the next source gives the body" {
  inspect(
    selectors_of(
      (
        #|{
        #|  "404": {
        #|    "content": {
        #|      "application/json": {
        #|        "examples": {
        #|          "a": { "externalValue": "https://example.com/a.json" },
        #|          "b": { "summary": "No value" },
        #|          "c": { "value": 3 },
        #|          "d": { "externalValue": "d.json" },
        #|          "e": { "value": 5 }
        #|        }
        #|      }
        #|    }
        #|  },
        #|  "200": {
        #|    "content": {
        #|      "application/json": {
        #|        "examples": { "f": { "externalValue": "f.json" } },
        #|        "example": 6
        #|      }
        #|    }
        #|  }
        #|}
      ),
    ),
    content=(
      #|petstore.json: /paths/~1r/get/responses/404/content/application~1json/examples/a: warning: left out: smock does not read externalValue, and the example has no dataValue, value or serializedValue
      #|petstore.json: /paths/~1r/get/responses/404/content/application~1json/examples/b: warning: left out: the example has no dataValue, value or serializedValue
      #|petstore.json: /paths/~1r/get/responses/404/content/application~1json/examples/d: warning: left out: smock does not read externalValue, and the example has no dataValue, value or serializedValue
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples/f: warning: left out: smock does not read externalValue, and the example has no dataValue, value or serializedValue
      #|petstore.r.404.e: [Smock-Status: 404, Smock-Example: e] -> 404 json 5
      #|petstore.r.404: [Smock-Status: 404] -> 404 json 3
      #|petstore.r.200: [] -> 200 json 6
      #|
    ),
  )
  inspect(
    examples_of(
      (
        #|{
        #|  "200": {
        #|    "content": {
        #|      "text/plain": {
        #|        "examples": { "f": { "description": "Nothing" } },
        #|        "schema": { "const": "from the schema" }
        #|      }
        #|    }
        #|  }
        #|}
      ),
    ),
    content=(
      #|petstore.json: /paths/~1r/get/responses/200/content/text~1plain/examples/f: warning: left out: the example has no dataValue, value or serializedValue
      #|  # GET /r, 200
      #|  - id: petstore.r.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|    response:
      #|      status: 200
      #|      headers:
      #|        Content-Type: text/plain
      #|      body: from the schema
      #|
    ),
  )
}

///|
test "an Example Object that is not an object, a serializedValue that is not a string, and examples that is not an object are errors at their pointers" {
  inspect(
    selectors_of(
      (
        #|{
        #|  "404": { "content": { "application/json": { "examples": { "a": [1], "b": { "value": 2 } } } } },
        #|  "500": { "content": { "application/json": { "examples": { "c": { "value": 3, "serializedValue": 3 } } } } },
        #|  "200": { "content": { "application/json": { "examples": [{ "value": 1 }] } } }
        #|}
      ),
    ),
    content=(
      #|petstore.json: /paths/~1r/get/responses/404/content/application~1json/examples/a: must be an object
      #|petstore.json: /paths/~1r/get/responses/500/content/application~1json/examples/c/serializedValue: must be a string
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples: must be an object
      #|nothing written
      #|
    ),
  )
}

///|
test "a $ref inside example data is copied as data, and an Example Object reached through a Reference Object is followed" {
  inspect(
    import_to(
      (
        #|{
        #|  "openapi": "3.2.0",
        #|  "paths": {
        #|    "/r": {
        #|      "get": {
        #|        "operationId": "r",
        #|        "responses": {
        #|          "404": { "content": { "application/json": { "example": { "$ref": "#/components/schemas/Pet" } } } },
        #|          "200": {
        #|            "content": {
        #|              "application/json": {
        #|                "examples": {
        #|                  "schema": { "$ref": "#/components/examples/Schema", "summary": "Ignored" },
        #|                  "data": { "dataValue": { "$ref": "#/nowhere" } },
        #|                  "chained": { "$ref": "#/components/examples/Chained" }
        #|                }
        #|              }
        #|            }
        #|          }
        #|        }
        #|      }
        #|    }
        #|  },
        #|  "components": {
        #|    "examples": {
        #|      "Schema": { "value": { "$ref": "#/components/schemas/Pet", "type": "object" } },
        #|      "Chained": { "$ref": "#/components/examples/Cat" },
        #|      "Cat": { "value": { "name": "Tom" } }
        #|    },
        #|    "schemas": { "Pet": { "type": "object" } }
        #|  }
        #|}
      ),
    ),
    content=(
      #|4 Stubs from 1 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (OpenAPI 3.2.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|version: 1
      #|mocks:
      #|  - name: petstore
      #|stubs:
      #|  # GET /r, 404
      #|  - id: petstore.r.404
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "404"
      #|    response:
      #|      status: 404
      #|      json:
      #|        $ref: "#/components/schemas/Pet"
      #|  # GET /r, 200, example data
      #|  - id: petstore.r.200.data
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Example: data
      #|    response:
      #|      status: 200
      #|      json:
      #|        $ref: "#/nowhere"
      #|  # GET /r, 200, example chained
      #|  - id: petstore.r.200.chained
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Example: chained
      #|    response:
      #|      status: 200
      #|      json:
      #|        name: Tom
      #|  # GET /r, 200, example schema
      #|  - id: petstore.r.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|    response:
      #|      status: 200
      #|      json:
      #|        $ref: "#/components/schemas/Pet"
      #|        type: object
      #|
    ),
  )
  inspect(
    examples_of(
      (
        #|{
        #|  "200": {
        #|    "content": {
        #|      "application/json": {
        #|        "examples": {
        #|          "a": { "value": 1 },
        #|          "b": { "$ref": "#/components/examples/Missing" },
        #|          "c": { "$ref": "#/paths/~1r/get/responses/200/content/application~1json/examples/c" }
        #|        }
        #|      }
        #|    }
        #|  }
        #|}
      ),
    ),
    content=(
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples/b/$ref: the document has nothing at /components/examples/Missing
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples/c/$ref: a cycle of references: this one leads back to petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples/c
      #|nothing written
      #|
    ),
  )
}

///|
/// The Stubs of the file that converting one `GET /r` operation with the
/// Responses Object `responses`, given as JSON text, gives, one per line
/// after the problems: the ID, the Content-Type, if any, and the length of
/// the `json`, as compact JSON, or of the `body`, in UTF-8 bytes.
fn body_sizes_of(responses : String) -> String raise {
  let document = "{ \"openapi\": \"3.2.0\", \"paths\": { \"/r\": { \"get\": { \"operationId\": \"r\", \"responses\": \{responses} } } } }"
  let conversion = @importopenapi.convert(
    [("petstore.json", @utf8.encode(document))],
    @importopenapi.Options(
      root="petstore.json",
      mock="petstore",
      output="defs/petstore.json",
    ),
  )
  let out = StringBuilder()
  for problem in conversion.problems() {
    out.write_string(problem.to_string())
    out.write_char('\n')
  }
  guard conversion is Converted(file~, ..) else {
    out.write_string("nothing written\n")
    return out.to_string()
  }
  guard @json.parse(@utf8.decode(file)) is Object({ "stubs": Array(stubs), .. }) else {
    fail("the file has no stubs")
  }
  for stub in stubs {
    guard stub is Object({ "id": String(id), "response": Object(response), .. }) else {
      fail("unexpected Stub: \{stub.stringify()}")
    }
    let content_type = match response.get("headers") {
      Some(Object({ "Content-Type": String(content_type), .. })) =>
        " \{content_type}"
      _ => ""
    }
    let body = match response {
      { "json": json, .. } => "json \{@utf8.encode(json.stringify()).length()}"
      { "body": String(text), .. } => "body \{@utf8.encode(text).length()}"
      _ => "empty"
    }
    out.write_string("\{id}:\{content_type} \{body}\n")
  }
  out.to_string()
}

///|
test "an example body above 1 MiB, its compact JSON or its text in UTF-8, is left empty, with a warning" {
  let mib = 1024 * 1024
  let x = "x"
  inspect(
    body_sizes_of(
      (
        $|{
        $|  "201": { "content": { "application/json": { "examples": { "e": { "value": "\{x.repeat(mib - 2)}" } } } } },
        $|  "202": { "content": { "application/json": { "examples": { "e": { "dataValue": "\{x.repeat(mib - 1)}" } } } } },
        $|  "203": { "content": { "text/plain": { "examples": { "e": { "serializedValue": "\{x.repeat(mib)}" } } } } },
        $|  "206": { "content": { "text/plain": { "examples": { "e": { "serializedValue": "\{x.repeat(mib + 1)}" } } } } },
        $|  "207": { "content": { "application/json": { "example": "\{x.repeat(mib - 1)}" } } },
        $|  "208": { "content": { "text/plain": { "example": "\{"é".repeat(mib / 2 + 1)}" } } },
        $|  "209": { "content": { "application/json": { "examples": { "e": { "serializedValue": "\{x.repeat(mib + 1)}" } } } } },
        $|  "200": { "content": { "application/json": { "examples": { "small": { "value": 1 }, "big": { "value": [ "\{x.repeat(mib)}" ] } } } } }
        $|}
      ),
    ),
    content=(
      #|petstore.json: /paths/~1r/get/responses/202/content/application~1json/examples/e/dataValue: warning: left out: the body is empty, since the example is more than 1 MiB
      #|petstore.json: /paths/~1r/get/responses/206/content/text~1plain/examples/e/serializedValue: warning: left out: the body is empty, since the example is more than 1 MiB
      #|petstore.json: /paths/~1r/get/responses/207/content/application~1json/example: warning: left out: the body is empty, since the example is more than 1 MiB
      #|petstore.json: /paths/~1r/get/responses/208/content/text~1plain/example: warning: left out: the body is empty, since the example is more than 1 MiB
      #|petstore.json: /paths/~1r/get/responses/209/content/application~1json/examples/e/serializedValue: warning: left out: the body is empty, since the example is more than 1 MiB
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples/big/value: warning: left out: the body is empty, since the example is more than 1 MiB
      #|petstore.r.201: json 1048576
      #|petstore.r.202: application/json empty
      #|petstore.r.203: text/plain body 1048576
      #|petstore.r.206: text/plain empty
      #|petstore.r.207: application/json empty
      #|petstore.r.208: text/plain empty
      #|petstore.r.209: application/json empty
      #|petstore.r.200.big: application/json empty
      #|petstore.r.200: json 1
      #|
    ),
  )
}

///|
test "a name a client cannot send, empty, with a character outside visible ASCII and space, or with a space at either end, gets no Stub, with a warning; as the first example, it still gives the body, and the comment quotes it" {
  inspect(
    examples_of(
      (
        #|{
        #|  "200": {
        #|    "content": {
        #|      "application/json": {
        #|        "examples": {
        #|          " first": { "value": "first" },
        #|          "": { "value": "empty" },
        #|          "last ": { "value": "last" },
        #|          "café": { "value": "café" },
        #|          "tab\there": { "value": "tab" },
        #|          "line\nbreak": { "value": "line" },
        #|          "DEL\u007f": { "value": "del" },
        #|          "with space": { "value": "with space" },
        #|          "$exists": { "value": "$exists" },
        #|          "${x}": { "value": "${x}" },
        #|          "!\"#~": { "value": "punctuation" }
        #|        }
        #|      }
        #|    }
        #|  },
        #|  "404": { "content": { "application/json": { "examples": { "": { "value": "only" } } } } }
        #|}
      ),
    ),
    content=(
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples/: warning: left out: no Stub selects this example, since a request cannot send its name in Smock-Example: a name must be non-empty, of visible ASCII characters and spaces, with no space at either end
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples/last : warning: left out: no Stub selects this example, since a request cannot send its name in Smock-Example: a name must be non-empty, of visible ASCII characters and spaces, with no space at either end
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples/café: warning: left out: no Stub selects this example, since a request cannot send its name in Smock-Example: a name must be non-empty, of visible ASCII characters and spaces, with no space at either end
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples/tab	here: warning: left out: no Stub selects this example, since a request cannot send its name in Smock-Example: a name must be non-empty, of visible ASCII characters and spaces, with no space at either end
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples/line\nbreak: warning: left out: no Stub selects this example, since a request cannot send its name in Smock-Example: a name must be non-empty, of visible ASCII characters and spaces, with no space at either end
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/examples/DEL\u{7f}: warning: left out: no Stub selects this example, since a request cannot send its name in Smock-Example: a name must be non-empty, of visible ASCII characters and spaces, with no space at either end
      #|  # GET /r, 404, example ""
      #|  - id: petstore.r.404
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "404"
      #|    response:
      #|      status: 404
      #|      json: only
      #|  # GET /r, 200, example with space
      #|  - id: petstore.r.200.with space
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Example: with space
      #|    response:
      #|      status: 200
      #|      json: with space
      #|  # GET /r, 200, example $exists
      #|  - id: petstore.r.200.$exists
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Example: $exists
      #|    response:
      #|      status: 200
      #|      json: $exists
      #|  # GET /r, 200, example ${x}
      #|  - id: petstore.r.200.${x}
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Example: ${x}
      #|    response:
      #|      status: 200
      #|      json: ${x}
      #|  # GET /r, 200, example !"#~
      #|  - id: petstore.r.200.!"#~
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Example: "!\"#~"
      #|    response:
      #|      status: 200
      #|      json: punctuation
      #|  # GET /r, 200, example " first"
      #|  - id: petstore.r.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|    response:
      #|      status: 200
      #|      json: first
      #|
    ),
  )
}

///|
test "examples are copied as they are: ${ and keys that start with $ need no escaping, since the file has no template" {
  inspect(
    examples_of(
      (
        #|{
        #|  "200": {
        #|    "content": {
        #|      "application/json": {
        #|        "examples": {
        #|          "a": { "value": { "$each": "${items}", "$$name": "x", "$if": { "$ref": "#/x" } } },
        #|          "b": { "value": "${request.path}" }
        #|        }
        #|      }
        #|    }
        #|  },
        #|  "404": { "content": { "text/plain": { "example": "Not ${found}" } } }
        #|}
      ),
    ),
    content=(
      #|  # GET /r, 404
      #|  - id: petstore.r.404
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "404"
      #|    response:
      #|      status: 404
      #|      headers:
      #|        Content-Type: text/plain
      #|      body: Not ${found}
      #|  # GET /r, 200, example b
      #|  - id: petstore.r.200.b
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Example: b
      #|    response:
      #|      status: 200
      #|      json: ${request.path}
      #|  # GET /r, 200, example a
      #|  - id: petstore.r.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|    response:
      #|      status: 200
      #|      json:
      #|        $each: ${items}
      #|        $$name: x
      #|        $if:
      #|          $ref: "#/x"
      #|
    ),
  )
}

///|
test "an example ID that repeats another Stub's ID is an error that names both places" {
  inspect(
    stubs_of(
      with_paths(
        (
          #|{
          #|  "/a": {
          #|    "get": {
          #|      "operationId": "a",
          #|      "responses": {
          #|        "200": { "content": { "application/json": { "examples": { "one": { "value": 1 }, "default": { "value": 2 } } } } }
          #|      }
          #|    }
          #|  },
          #|  "/b": { "get": { "operationId": "a.200", "responses": { "200": {}, "default": {} } } }
          #|}
        ),
      ),
    ),
    content=(
      #|petstore.json: /paths/~1b/get: the Stub ID "petstore.a.200.default" is already generated for the operation at petstore.json: /paths/~1a/get
      #|nothing written
      #|
    ),
  )
}

///|
test "dataValue and serializedValue are read in every OpenAPI version, and a 3.2 Media Type Object reached through a $ref gives its examples" {
  inspect(
    selectors_of(
      (
        #|{
        #|  "404": { "content": { "text/plain": { "examples": { "a": { "serializedValue": "Not found", "value": "x" } } } } },
        #|  "200": { "content": { "application/json": { "examples": { "a": { "dataValue": 1, "value": 2 }, "b": { "dataValue": 3 } } } } }
        #|}
      ),
      openapi="3.0.3",
    ),
    content=(
      #|petstore.r.404: [Smock-Status: 404] -> 404 body "Not found"
      #|petstore.r.200.b: [Smock-Example: b] -> 200 json 3
      #|petstore.r.200: [] -> 200 json 1
      #|
    ),
  )
  inspect(
    selectors_of(
      (
        #|{
        #|  "200": { "content": { "application/json": { "$ref": "#/paths/~1r/get/responses/x-media" } } },
        #|  "x-media": { "examples": { "a": { "value": 1 }, "b": { "$ref": "#/paths/~1r/get/responses/x-example" } } },
        #|  "x-example": { "value": 2 }
        #|}
      ),
    ),
    content=(
      #|petstore.r.200.b: [Smock-Example: b] -> 200 json 2
      #|petstore.r.200: [] -> 200 json 1
      #|
    ),
  )
}

///|
test "in 3.0 and 3.1 a Media Type Object is read as written: its $ref is not followed, but ignored with a warning" {
  let responses =
    #|{
    #|  "200": { "content": { "application/json": { "$ref": "#/nowhere", "example": { "name": "Tom" } } } },
    #|  "404": { "content": { "application/json": { "$ref": "https://example.com/pet.json" } } },
    #|  "500": { "content": { "application/json": { "$ref": "#/components/schemas/Pet" } } }
    #|}
  let v30 = examples_of(responses, openapi="3.0.3")
  assert_eq(v30, examples_of(responses, openapi="3.1.0"))
  inspect(
    v30,
    content=(
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/$ref: warning: ignored: a Media Type is a reference only from OpenAPI 3.2
      #|petstore.json: /paths/~1r/get/responses/404/content/application~1json/$ref: warning: ignored: a Media Type is a reference only from OpenAPI 3.2
      #|petstore.json: /paths/~1r/get/responses/500/content/application~1json/$ref: warning: ignored: a Media Type is a reference only from OpenAPI 3.2
      #|  # GET /r, 404
      #|  - id: petstore.r.404
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "404"
      #|    response:
      #|      status: 404
      #|      headers:
      #|        Content-Type: application/json
      #|  # GET /r, 500
      #|  - id: petstore.r.500
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|      headers:
      #|        Smock-Status: "500"
      #|    response:
      #|      status: 500
      #|      headers:
      #|        Content-Type: application/json
      #|  # GET /r, 200
      #|  - id: petstore.r.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /r
      #|    response:
      #|      status: 200
      #|      json:
      #|        name: Tom
      #|
    ),
  )
  inspect(
    examples_of(responses),
    content=(
      #|petstore.json: /paths/~1r/get/responses/200/content/application~1json/$ref: the document has nothing at /nowhere
      #|petstore.json: /paths/~1r/get/responses/404/content/application~1json/$ref: smock reads no URLs and no absolute paths: bundle the document into one file first, with another tool
      #|petstore.json: /paths/~1r/get/responses/500/content/application~1json/$ref: the document has nothing at /components/schemas/Pet
      #|nothing written
      #|
    ),
  )
}
