///|
/// The largest file the converter writes: 64 MiB. smock serve holds the
/// whole definition set in memory.
let max_file_bytes : Int = 64 * 1024 * 1024

///|
/// The Definition file of the imported operations, unless a problem so far
/// is an error. The file declares the one Mock, then each Stub. It is YAML
/// when the output's name ends in `.yaml` or `.yml`, with a comment at the
/// top and one above each Stub, and JSON otherwise, with two spaces per
/// level and smock's number rule. It must load, with the loader
/// `smock check` uses, as a set of its own, and give no warning.
fn Report::file(
  self : Report,
  document : Document,
  imported : Array[Imported],
) -> Outcome {
  if self.errors > 0 {
    return Failed(self.problems)
  }
  let stubs = []
  for operation in imported {
    for stub in operation.stubs {
      stubs.push(stub.to_json(self.options.mock))
    }
  }
  let file : Map[String, Json] = { "version": 1 }
  if self.options.declare_mock {
    file["mocks"] = [self.mock()]
  }
  file["stubs"] = Json::array(stubs)
  let file = Json::object(file)
  let bytes = if @definitions.is_yaml_name(self.options.output) {
    guard self.yaml_file(file, document, imported) is Some(bytes) else {
      return Failed(self.problems)
    }
    bytes
  } else {
    @template.indented_json_bytes(file) + b"\n"
  }
  if !self.checked(bytes, max_bytes=max_file_bytes) {
    return Failed(self.problems)
  }
  Converted(
    file=bytes,
    problems=self.problems,
    stubs=stubs.length(),
    operations=imported.length(),
  )
}

///|
/// The Mock the file declares: its name, then its Hosts, when it has any,
/// and nothing else.
fn Report::mock(self : Report) -> Json {
  let mock : Map[String, Json] = { "name": self.options.mock.to_json() }
  if !self.options.hosts.is_empty() {
    mock["hosts"] = self.options.hosts.to_json()
  }
  Json::object(mock)
}

///|
/// `file` as YAML, with the comment at the top and one above each Stub of
/// `imported`, or `None` after reporting why the writer could not write it,
/// which is a smock bug.
fn Report::yaml_file(
  self : Report,
  file : Json,
  document : Document,
  imported : Array[Imported],
) -> Bytes? {
  let comments : Map[String, Array[String]] = Map([])
  let mut index = 0
  for operation in imported {
    for stub in operation.stubs {
      comments["/stubs/\{index}"] = [operation.comment(stub)]
      index += 1
    }
  }
  try
    @yaml.write(file, comment=self.header(document), item_comments=comments)
  catch {
    WriteError(pointer~, message~) => {
      self.output_error(
        "smock bug: the file cannot be written as YAML at \{pointer}: \{message}",
      )
      None
    }
  } noraise {
    bytes => Some(bytes)
  }
}

///|
/// The comment at the top of a YAML file. It says that the file was
/// generated, from which document, named by its base name, with its title,
/// version and OpenAPI version, and with the flags that shape the file
/// whose value is not the default; and that it should not be edited. It
/// holds no path and no smock version, so the same import gives the same
/// bytes from any directory and after an upgrade that does not change the
/// conversion. The title and the version are left out where they are
/// empty, and spaces and tabs around them are dropped.
fn Report::header(self : Report, document : Document) -> Array[String] {
  let about = []
  for part in [document.title, document.info_version] {
    let part = part.trim(chars=" \t")
    if !part.is_empty() {
      about.push(part.to_owned())
    }
  }
  let source = if about.is_empty() {
    "OpenAPI \{document.openapi}"
  } else {
    "\{about.join(" ")}, OpenAPI \{document.openapi}"
  }
  [
    "Generated by smock import-openapi from \{base_name(self.options.root)}",
    "(\{source}), with \{self.flags()}.",
    "Do not edit: the next import replaces this file.",
  ]
}

///|
/// The flags that shape the file, as the header comment lists them, in a
/// fixed order: `--mock`, then `--hosts` when the Mock has Hosts, then
/// `--declare-mock off` when the file does not declare it, then
/// `--base-path`, as given, when there is one. `on` is the default and is
/// not listed, so that giving it changes no byte.
fn Report::flags(self : Report) -> String {
  let flags = ["--mock \{self.options.mock}"]
  if !self.options.hosts.is_empty() {
    flags.push("--hosts \{self.options.hosts.join(",")}")
  }
  if !self.options.declare_mock {
    flags.push("--declare-mock off")
  }
  if self.options.base_path is Some(base_path) {
    flags.push("--base-path \{base_path}")
  }
  flags.join(" ")
}

///|
/// The comment above `stub`, a Stub of this operation, which maps it back
/// to the document: the method, the path as written, the response key, the
/// name of the named example its body comes from, if any, `sample cut`
/// when its body is a sample cut to its required parts, `deprecated` when
/// the operation is, and the first line of its summary. A name that a
/// request cannot send is quoted.
fn Imported::comment(self : Imported, stub : Stub) -> String {
  let comment = StringBuilder()
  comment.write_string("\{stub.meth} \{self.key}, \{stub.response}")
  if stub.example is Some(example) {
    let example = if is_sendable(example) { example } else { example.escape() }
    comment.write_string(", example \{example}")
  }
  if stub.cut {
    comment.write_string(", sample cut")
  }
  if self.deprecated {
    comment.write_string(", deprecated")
  }
  let summary = first_line(self.summary)
  if summary != "" {
    comment.write_string(": \{summary}")
  }
  comment.to_string()
}

///|
/// The first line of `text`, up to its first line feed or carriage return,
/// without the spaces and tabs at either end.
fn first_line(text : String) -> String {
  let mut end = text.length()
  for i in 0..<text.length() {
    let c = text.unsafe_get(i)
    if c == '\n' || c == '\r' {
      end = i
      break
    }
  }
  text[:end].trim(chars=" \t").to_owned()
}

///|
/// The last name of `path`, after its last `/`.
fn base_name(path : String) -> String {
  match path.rev_find("/") {
    Some(i) => path[i + 1:].to_owned()
    None => path
  }
}

///|
/// A Stub of the Mock `mock` as the file writes it: `id`, `mock`, `request`
/// (`method`, `path`, an exact path or `{ pattern }`, then `headers` with
/// `Smock-Status` for a response other than the main one, then
/// `Smock-Example` for a named example other than the first), then
/// `response` (`status`, `headers` with the Content-Type, then the
/// documented headers in the order the document writes them, then `json`
/// or `body`).
fn Stub::to_json(self : Stub, mock : String) -> Json {
  let path : Json = match self.path {
    Exact(path) => path.to_json()
    Pattern(pattern) => { "pattern": pattern.to_json() }
  }
  let request : Map[String, Json] = { "method": self.meth, "path": path }
  if self.selected || self.named {
    let headers : Map[String, Json] = Map([])
    if self.selected {
      headers["Smock-Status"] = self.response.to_json()
    }
    if self.named && self.example is Some(example) {
      headers["Smock-Example"] = example.to_json()
    }
    request["headers"] = Json::object(headers)
  }
  let response : Map[String, Json] = { "status": self.status.to_json() }
  if self.payload.content_type is Some(_) || !self.headers.is_empty() {
    let headers : Map[String, Json] = Map([])
    if self.payload.content_type is Some(content_type) {
      headers["Content-Type"] = content_type.to_json()
    }
    for header in self.headers {
      headers[header.0] = header.1.to_json()
    }
    response["headers"] = Json::object(headers)
  }
  match self.payload.body {
    Empty => ()
    JsonValue(json) => response["json"] = json
    Text(text) => response["body"] = Json::string(text)
  }
  {
    "id": self.id,
    "mock": mock,
    "request": Json::object(request),
    "response": Json::object(response),
  }
}

///|
/// Whether `bytes`, the file, is at most `max_bytes` long and loads as a
/// set of its own with no problem and no warning. When the file does not
/// declare its Mock, the set also holds a stand-in file that declares a
/// Mock of that name and nothing else, as the file that declares it by
/// hand would. Each problem it gives is reported as an error with the file,
/// with no pointer, which is a smock bug; the message names the file and
/// the pointer of the problem, the stand-in's own when it is in the
/// stand-in. Problems with the file come before the others.
fn Report::checked(self : Report, bytes : Bytes, max_bytes~ : Int) -> Bool {
  let output = self.options.output
  if bytes.length() > max_bytes {
    self.output_error(
      "the file would be \{bytes.length()} bytes, more than \{size_text(max_bytes)}",
    )
    return false
  }
  let files = [(output, bytes)]
  if !self.options.declare_mock {
    files.push(self.stand_in())
  }
  match @definitions.load({ files, body_files: [], }) {
    Ok(snapshot) =>
      for warning in snapshot.warnings() {
        self.output_error(
          "smock bug: the file would give the warning: \{warning.to_string()}",
        )
      }
    Err(diagnostics) =>
      for diagnostic in diagnostics {
        self.output_error(
          "smock bug: the file would not load: \{diagnostic.to_string()}",
        )
      }
  }
  self.errors == 0
}

///|
/// The stand-in file of the self-check, as a (name, bytes) pair: a
/// Definition file that declares the Mock and nothing else. Its name is
/// never the output's.
fn Report::stand_in(self : Report) -> (String, Bytes) {
  let file : Json = { "mocks": [{ "name": self.options.mock }] }
  ("\{self.options.output}.mock.json", @utf8.encode(file.stringify()))
}

///|
/// `bytes` as a size: in MiB when it is a whole number of them, such as
/// `64 MiB`, else in bytes.
fn size_text(bytes : Int) -> String {
  let mib = 1024 * 1024
  if bytes >= mib && bytes % mib == 0 {
    "\{bytes / mib} MiB"
  } else {
    "\{bytes} bytes"
  }
}
