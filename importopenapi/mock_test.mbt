// The Mock the file declares: its name and Hosts, or none, for a Mock that
// another file declares.

///|
/// An OpenAPI document whose only operation is `listPets` on `GET /pets`,
/// with a `200` response and no content.
let list_pets : String =
  #|{
  #|  "openapi": "3.1.0",
  #|  "info": { "title": "Petstore", "version": "1.0.0" },
  #|  "paths": {
  #|    "/pets": {
  #|      "get": { "operationId": "listPets", "responses": { "200": {} } }
  #|    }
  #|  }
  #|}

///|
/// Converts `list_pets`, named `petstore.json`, into `output` for the Mock
/// `petstore` with the Hosts `hosts`, declaring the Mock or not, and renders
/// what came out, as `import_json` does.
fn import_mock(
  output~ : String = "defs/petstore.yaml",
  hosts~ : Array[String] = [],
  declare_mock~ : Bool = true,
) -> String {
  let options = @importopenapi.Options(
    root="petstore.json",
    mock="petstore",
    output~,
    hosts~,
    declare_mock~,
  )
  rendered(
    @importopenapi.convert(
      [("petstore.json", @utf8.encode(list_pets))],
      options,
    ),
  )
}

///|
test "the Mock is declared with the Hosts given, as given and in that order, and nothing else; the header comment lists them after --mock" {
  inspect(
    import_mock(hosts=["petstore.test", "Pets.Internal:8080", "[::1]:8080"]),
    content=(
      #|1 Stubs from 1 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (Petstore 1.0.0, OpenAPI 3.1.0), with --mock petstore --hosts petstore.test,Pets.Internal:8080,[::1]:8080.
      #|# Do not edit: the next import replaces this file.
      #|version: 1
      #|mocks:
      #|  - name: petstore
      #|    hosts:
      #|      - petstore.test
      #|      - Pets.Internal:8080
      #|      - "[::1]:8080"
      #|stubs:
      #|  # GET /pets, 200
      #|  - id: petstore.listPets.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /pets
      #|    response:
      #|      status: 200
      #|
    ),
  )
  inspect(
    import_mock(output="defs/petstore.json", hosts=["petstore.test"]),
    content=(
      #|1 Stubs from 1 operations
      #|{
      #|  "version": 1,
      #|  "mocks": [
      #|    {
      #|      "name": "petstore",
      #|      "hosts": [
      #|        "petstore.test"
      #|      ]
      #|    }
      #|  ],
      #|  "stubs": [
      #|    {
      #|      "id": "petstore.listPets.200",
      #|      "mock": "petstore",
      #|      "request": {
      #|        "method": "GET",
      #|        "path": "/pets"
      #|      },
      #|      "response": {
      #|        "status": 200
      #|      }
      #|    }
      #|  ]
      #|}
      #|
    ),
  )
}

///|
test "with declare_mock off, the file holds only version and Stubs, for a Mock that another file declares; it loads with a stand-in Mock of that name, and the header comment lists --declare-mock off after --mock" {
  inspect(
    import_mock(declare_mock=false),
    content=(
      #|1 Stubs from 1 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (Petstore 1.0.0, OpenAPI 3.1.0), with --mock petstore --declare-mock off.
      #|# Do not edit: the next import replaces this file.
      #|version: 1
      #|stubs:
      #|  # GET /pets, 200
      #|  - id: petstore.listPets.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /pets
      #|    response:
      #|      status: 200
      #|
    ),
  )
  inspect(
    import_mock(output="defs/petstore.json", declare_mock=false),
    content=(
      #|1 Stubs from 1 operations
      #|{
      #|  "version": 1,
      #|  "stubs": [
      #|    {
      #|      "id": "petstore.listPets.200",
      #|      "mock": "petstore",
      #|      "request": {
      #|        "method": "GET",
      #|        "path": "/pets"
      #|      },
      #|      "response": {
      #|        "status": 200
      #|      }
      #|    }
      #|  ]
      #|}
      #|
    ),
  )
}
