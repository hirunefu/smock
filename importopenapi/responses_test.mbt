// Every documented response, not only the main one, gets its own Stub. A
// request selects it with the header `Smock-Status`, whose value is the
// response key as the document writes it. Without the header, the main
// Stub answers.

///|
test "each other response gets a Stub of its own, selected by Smock-Status with its key as written, before the main Stub" {
  inspect(
    import_to(
      (
        #|{
        #|  "openapi": "3.1.0",
        #|  "info": { "title": "Petstore", "version": "1.0.0" },
        #|  "paths": {
        #|    "/pets/mine": {
        #|      "get": {
        #|        "operationId": "getPet",
        #|        "summary": "Find my pet",
        #|        "responses": {
        #|          "200": { "description": "My pet" },
        #|          "404": { "description": "No pet" }
        #|        }
        #|      }
        #|    }
        #|  }
        #|}
      ),
    ),
    content=(
      #|2 Stubs from 1 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (Petstore 1.0.0, OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|version: 1
      #|mocks:
      #|  - name: petstore
      #|stubs:
      #|  # GET /pets/mine, 404: Find my pet
      #|  - id: petstore.getPet.404
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /pets/mine
      #|      headers:
      #|        Smock-Status: "404"
      #|    response:
      #|      status: 404
      #|  # GET /pets/mine, 200: Find my pet
      #|  - id: petstore.getPet.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /pets/mine
      #|    response:
      #|      status: 200
      #|
    ),
  )
}

///|
/// The Stubs of the file that converting one `GET /r` operation with the
/// Responses Object `responses`, given as JSON text, gives, one per line
/// after the problems: the ID, the `Smock-Status` the request must send,
/// if any, and the status.
fn selected(responses : String) -> String raise {
  let document = "{ \"openapi\": \"3.1.0\", \"paths\": { \"/r\": { \"get\": { \"operationId\": \"r\", \"responses\": \{responses} } } } }"
  let options = @importopenapi.Options(
    root="petstore.json",
    mock="petstore",
    output="defs/petstore.json",
  )
  let conversion = @importopenapi.convert(
    [("petstore.json", @utf8.encode(document))],
    options,
  )
  let out = StringBuilder()
  for problem in conversion.problems() {
    out.write_string(problem.to_string())
    out.write_char('\n')
  }
  guard conversion is Converted(file~, ..) else {
    out.write_string("nothing written\n")
    return out.to_string()
  }
  guard @json.parse(@utf8.decode(file)) is Object({ "stubs": Array(stubs), .. }) else {
    fail("the file has no stubs")
  }
  for stub in stubs {
    guard stub
      is Object(
        {
          "id": String(id),
          "request": Object(request),
          "response": Object({ "status": Number(status, ..), .. }),
          ..
        }
      ) else {
      fail("unexpected Stub: \{stub.stringify()}")
    }
    let selector = match request.get("headers") {
      None => ""
      Some(Object(headers)) if headers.length() == 1 &&
        headers.get("Smock-Status") is Some(String(key)) =>
        " Smock-Status: \{key}"
      Some(headers) => fail("unexpected headers: \{headers.stringify()}")
    }
    out.write_string("\{id}:\{selector} -> \{status}\n")
  }
  out.to_string()
}

///|
test "an explicit code from 200 to 599 answers itself, 2XX to 5XX answer 200 to 500, and default, when it is not the main response, answers 500" {
  inspect(
    selected(
      (
        #|{
        #|  "201": {}, "204": {}, "301": {}, "404": {}, "599": {},
        #|  "2XX": {}, "3XX": {}, "4XX": {}, "5XX": {},
        #|  "default": {}, "200": {}
        #|}
      ),
    ),
    content=(
      #|petstore.r.201: Smock-Status: 201 -> 201
      #|petstore.r.204: Smock-Status: 204 -> 204
      #|petstore.r.301: Smock-Status: 301 -> 301
      #|petstore.r.404: Smock-Status: 404 -> 404
      #|petstore.r.599: Smock-Status: 599 -> 599
      #|petstore.r.2XX: Smock-Status: 2XX -> 200
      #|petstore.r.3XX: Smock-Status: 3XX -> 300
      #|petstore.r.4XX: Smock-Status: 4XX -> 400
      #|petstore.r.5XX: Smock-Status: 5XX -> 500
      #|petstore.r.default: Smock-Status: default -> 500
      #|petstore.r.200: -> 200
      #|
    ),
  )
}

///|
test "default as the main response answers 200 without Smock-Status, and as another one 500 with it" {
  inspect(
    selected(
      (
        #|{ "404": {}, "default": {}, "500": {} }
      ),
    ),
    content=(
      #|petstore.r.404: Smock-Status: 404 -> 404
      #|petstore.r.500: Smock-Status: 500 -> 500
      #|petstore.r.default: -> 200
      #|
    ),
  )
  inspect(
    selected(
      (
        #|{ "default": {}, "201": {} }
      ),
    ),
    content=(
      #|petstore.r.default: Smock-Status: default -> 500
      #|petstore.r.201: -> 201
      #|
    ),
  )
}

///|
test "1XX and explicit codes from 100 to 199 get no Stub, each with a warning at its place among the responses, since a smock status is from 200 to 599" {
  inspect(
    selected(
      (
        #|{ "100": {}, "404": {}, "1XX": {}, "200": {}, "199": {} }
      ),
    ),
    content=(
      #|petstore.json: /paths/~1r/get/responses/100: warning: left out: smock answers with a status from 200 to 599
      #|petstore.json: /paths/~1r/get/responses/1XX: warning: left out: smock answers with a status from 200 to 599
      #|petstore.json: /paths/~1r/get/responses/199: warning: left out: smock answers with a status from 200 to 599
      #|petstore.r.404: Smock-Status: 404 -> 404
      #|petstore.r.200: -> 200
      #|
    ),
  )
}

///|
test "within an operation, the other responses' Stubs come in the order the document writes them, then the main Stub, so the file gives no shadow warning" {
  inspect(
    import_to(
      (
        #|{
        #|  "openapi": "3.1.0",
        #|  "paths": {
        #|    "/a": {
        #|      "get": {
        #|        "operationId": "getA",
        #|        "responses": { "500": {}, "200": {}, "4XX": {}, "404": {} }
        #|      },
        #|      "delete": {
        #|        "deprecated": true,
        #|        "responses": { "default": {}, "409": {} }
        #|      }
        #|    }
        #|  }
        #|}
      ),
    ),
    content=(
      #|6 Stubs from 2 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|version: 1
      #|mocks:
      #|  - name: petstore
      #|stubs:
      #|  # GET /a, 500
      #|  - id: petstore.getA.500
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /a
      #|      headers:
      #|        Smock-Status: "500"
      #|    response:
      #|      status: 500
      #|  # GET /a, 4XX
      #|  - id: petstore.getA.4XX
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /a
      #|      headers:
      #|        Smock-Status: 4XX
      #|    response:
      #|      status: 400
      #|  # GET /a, 404
      #|  - id: petstore.getA.404
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /a
      #|      headers:
      #|        Smock-Status: "404"
      #|    response:
      #|      status: 404
      #|  # GET /a, 200
      #|  - id: petstore.getA.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /a
      #|    response:
      #|      status: 200
      #|  # DELETE /a, 409, deprecated
      #|  - id: petstore.DELETE /a.409
      #|    mock: petstore
      #|    request:
      #|      method: DELETE
      #|      path: /a
      #|      headers:
      #|        Smock-Status: "409"
      #|    response:
      #|      status: 409
      #|  # DELETE /a, default, deprecated
      #|  - id: petstore.DELETE /a.default
      #|    mock: petstore
      #|    request:
      #|      method: DELETE
      #|      path: /a
      #|    response:
      #|      status: 200
      #|
    ),
  )
}

///|
test "a generated ID that repeats is an error for each response's Stub, naming both places" {
  inspect(
    stubs_of(
      with_paths(
        (
          #|{
          #|  "/b": { "get": { "operationId": "GET /c", "responses": { "200": {}, "404": {} } } },
          #|  "/c": { "get": { "responses": { "404": {}, "500": {}, "200": {} } } }
          #|}
        ),
      ),
    ),
    content=(
      #|petstore.json: /paths/~1c/get: the Stub ID "petstore.GET /c.404" is already generated for the operation at petstore.json: /paths/~1b/get
      #|petstore.json: /paths/~1c/get: the Stub ID "petstore.GET /c.200" is already generated for the operation at petstore.json: /paths/~1b/get
      #|nothing written
      #|
    ),
  )
}
