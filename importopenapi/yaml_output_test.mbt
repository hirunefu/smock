// The YAML output: an --output whose name ends in .yaml or .yml is written
// as YAML, with a comment that says where the file came from, and a comment
// above each Stub that maps it back to the document.

///|
/// Converts `document`, a JSON OpenAPI document named `petstore.json`, into
/// the Definition file `output` for the Mock `mock`, with the base path
/// `base_path`, if given, and renders what came out, as `import_json`
/// does.
fn import_to(
  document : String,
  output? : String = "defs/petstore.yaml",
  mock? : String = "petstore",
  base_path? : String,
) -> String {
  let options = @importopenapi.Options(
    root="petstore.json",
    mock~,
    output~,
    base_path?,
  )
  rendered(
    @importopenapi.convert([("petstore.json", @utf8.encode(document))], options),
  )
}

///|
test "an --output whose name ends in .yaml is written as YAML: a comment says where it came from, and a comment above each Stub maps it back to the document" {
  inspect(
    import_to(
      (
        #|{
        #|  "openapi": "3.1.0",
        #|  "info": { "title": "Petstore", "version": "1.0.0" },
        #|  "paths": {
        #|    "/pets": {
        #|      "get": {
        #|        "operationId": "listPets",
        #|        "summary": "List all pets",
        #|        "responses": { "200": { "description": "A list of pets" } }
        #|      }
        #|    }
        #|  }
        #|}
      ),
    ),
    content=(
      #|1 Stubs from 1 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (Petstore 1.0.0, OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|version: 1
      #|mocks:
      #|  - name: petstore
      #|stubs:
      #|  # GET /pets, 200: List all pets
      #|  - id: petstore.listPets.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /pets
      #|    response:
      #|      status: 200
      #|
    ),
  )
}

///|
/// The file that converting `document`, a JSON OpenAPI document named
/// `petstore.json`, into `output` gives, as text.
fn file_text(document : String, output : String) -> String raise {
  let options = @importopenapi.Options(
    root="petstore.json",
    mock="petstore",
    output~,
  )
  match
    @importopenapi.convert([("petstore.json", @utf8.encode(document))], options) {
    Converted(file~, ..) => @utf8.decode(file)
    Failed(problems) =>
      fail(problems.map(problem => problem.to_string()).join("\n"))
    Needs(names) => fail("needs \{names.join(", ")}")
  }
}

///|
/// A document with two operations, a summary and a deprecated operation.
let two_operations : String =
  #|{
  #|  "openapi": "3.0.3",
  #|  "info": { "title": "Petstore", "version": "2" },
  #|  "paths": {
  #|    "/pets": {
  #|      "get": { "operationId": "listPets", "summary": "List all pets", "responses": { "200": {} } },
  #|      "post": { "deprecated": true, "responses": { "201": {} } }
  #|    }
  #|  }
  #|}

///|
test "the extension of --output picks the format: .yaml and .yml write the same YAML, .json writes JSON without comments, and all hold the same tree" {
  let yaml = file_text(two_operations, "defs/petstore.yaml")
  let yml = file_text(two_operations, "defs/petstore.yml")
  let json = file_text(two_operations, "defs/petstore.json")
  assert_eq(yml, yaml)
  assert_eq(@yaml.parse(yaml), @json.parse(json))
  assert_true(json.has_prefix("{\n"))
  assert_false(json.contains("List all pets"))
  inspect(
    yaml,
    content=(
      #|# Generated by smock import-openapi from petstore.json
      #|# (Petstore 2, OpenAPI 3.0.3), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|version: 1
      #|mocks:
      #|  - name: petstore
      #|stubs:
      #|  # GET /pets, 200: List all pets
      #|  - id: petstore.listPets.200
      #|    mock: petstore
      #|    request:
      #|      method: GET
      #|      path: /pets
      #|    response:
      #|      status: 200
      #|  # POST /pets, 201, deprecated
      #|  - id: petstore.POST /pets.201
      #|    mock: petstore
      #|    request:
      #|      method: POST
      #|      path: /pets
      #|    response:
      #|      status: 201
      #|
    ),
  )
}

///|
/// The first lines of the YAML file that converting a document of OpenAPI
/// `openapi`, with `info` as JSON text, gives, up to `version: 1`.
fn header_of(info : String, openapi? : String = "3.1.0") -> String raise {
  let info = if info == "" { "" } else { "\"info\": \{info}, " }
  let text = file_text(
    "{ \"openapi\": \"\{openapi}\", \{info}\"paths\": { \"/a\": { \"get\": {} } } }",
    "petstore.yaml",
  )
  let lines = []
  for line in text.split("\n") {
    if line == "version: 1" {
      break
    }
    lines.push(line.to_owned())
  }
  lines.join("\n")
}

///|
test "the comment at the top names the root document by its base name, with info.title, info.version and the OpenAPI version as written, and the flags that shape the file" {
  inspect(
    [
      header_of("{ \"title\": \"Petstore\", \"version\": \"1.0.0\" }"),
      header_of("{ \"title\": \"Petstore\" }", openapi="3.2.0"),
      header_of("{ \"version\": \"1.0.0\" }"),
      header_of("{ \"title\": \"\", \"version\": \"\" }"),
      header_of(""),
      header_of(
        "{ \"title\": \"Pet\\nstore\\u0000 \\u2028API\\t\", \"version\": \"v1 \\u0085beta\" }",
      ),
    ].join("\n---\n"),
    content=(
      #|# Generated by smock import-openapi from petstore.json
      #|# (Petstore 1.0.0, OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|---
      #|# Generated by smock import-openapi from petstore.json
      #|# (Petstore, OpenAPI 3.2.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|---
      #|# Generated by smock import-openapi from petstore.json
      #|# (1.0.0, OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|---
      #|# Generated by smock import-openapi from petstore.json
      #|# (OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|---
      #|# Generated by smock import-openapi from petstore.json
      #|# (OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|---
      #|# Generated by smock import-openapi from petstore.json
      #|# (Pet store   API v1  beta, OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
    ),
  )
}

///|
test "the comment names the root document by its base name only, so that no directory reaches the file" {
  let options = @importopenapi.Options(
    root="api/v1/petstore.json",
    root_label="/home/someone/project/api/v1/petstore.json",
    mock="petstore",
    output="/home/someone/project/defs/petstore.yaml",
  )
  guard @importopenapi.convert(
      [
        (
          "api/v1/petstore.json",
          @utf8.encode(with_version("\"openapi\": \"3.1.0\"")),
        ),
      ],
      options,
    )
    is Converted(file~, ..) else {
    fail("not converted")
  }
  let text = @utf8.decode(file)
  assert_false(text.contains("someone"))
  assert_false(text.contains("api/v1"))
  inspect(
    text.split("\n").take(3).map(line => line.to_owned()).collect().join("\n"),
    content=(
      #|# Generated by smock import-openapi from petstore.json
      #|# (OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
    ),
  )
}

///|
/// The comments above the Stubs of the YAML file that converting
/// `document` gives, one per line.
fn stub_comments(document : String) -> String raise {
  let lines = []
  for line in file_text(document, "petstore.yaml").split("\n") {
    if line.has_prefix("  # ") {
      lines.push(line[4:].to_owned())
    }
  }
  lines.join("\n")
}

///|
test "each Stub's comment gives the method, the path as written, the response key, deprecated where it applies, and the first line of the summary, with control characters as spaces" {
  inspect(
    stub_comments(
      with_paths(
        (
          #|{
          #|  "/pets": {
          #|    "get": { "summary": "List all pets\nwith paging\nand more", "responses": { "200": {} } },
          #|    "put": { "summary": "\r\nStarts with a line break", "responses": { "204": {} } },
          #|    "post": { "summary": "  Tab\there, DEL\u007f, NEL\u0085, LS PS , NUL\u0000end\t ", "responses": { "201": {} } },
          #|    "delete": { "summary": "Delete all pets", "deprecated": true, "responses": { "default": {} } },
          #|    "patch": { "summary": "", "deprecated": false, "responses": { "2XX": {} } },
          #|    "options": { "deprecated": true },
          #|    "additionalOperations": { "Copy": { "summary": "Copy\rpets", "responses": { "202": {} } } }
          #|  },
          #|  "/caf%C3%A9": { "head": { "summary": "Café", "responses": { "200": {} } } }
          #|}
        ),
      ),
    ),
    content=(
      #|GET /pets, 200: List all pets
      #|PUT /pets, 204
      #|POST /pets, 201: Tab here, DEL , NEL , LS PS , NUL end
      #|DELETE /pets, default, deprecated: Delete all pets
      #|PATCH /pets, 2XX
      #|OPTIONS /pets, 200, deprecated
      #|Copy /pets, 202: Copy
      #|HEAD /caf%C3%A9, 200: Café
    ),
  )
}

///|
test "a wrong-typed info, info.title or info.version is a warning at its pointer, for every format: the comment at the top leaves the value out, and the import goes on" {
  let infos = [
    "[]", "{ \"title\": 1, \"version\": 1.0 }", "{ \"title\": \"T\", \"version\": null }",
    "{ \"title\": [\"T\"], \"version\": \"1.0.0\" }",
  ]
  let rendered = []
  for info in infos {
    let document = "{ \"openapi\": \"3.1.0\", \"info\": \{info}, \"paths\": { \"/a\": { \"get\": { \"responses\": { \"200\": {} } } } } }"
    let yaml = import_to(document)
    // The JSON file has no comment, but the same problems and Stubs.
    guard yaml.find("# Generated") is Some(file) else { fail(yaml) }
    assert_true(
      import_to(document, output="defs/petstore.json").has_prefix(yaml[:file]),
    )
    let lines = []
    for line in yaml.split("\n") {
      if line == "version: 1" {
        break
      }
      lines.push(line.to_owned())
    }
    rendered.push(lines.join("\n"))
  }
  inspect(
    rendered.join("\n---\n"),
    content=(
      #|petstore.json: /info: warning: ignored: must be an object
      #|1 Stubs from 1 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|---
      #|petstore.json: /info/title: warning: ignored: must be a string
      #|petstore.json: /info/version: warning: ignored: must be a string: quote the version
      #|1 Stubs from 1 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|---
      #|petstore.json: /info/version: warning: ignored: must be a string
      #|1 Stubs from 1 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (T, OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
      #|---
      #|petstore.json: /info/title: warning: ignored: must be a string
      #|1 Stubs from 1 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# (1.0.0, OpenAPI 3.1.0), with --mock petstore.
      #|# Do not edit: the next import replaces this file.
    ),
  )
}

///|
test "the fields the Stub comments use are read for every format: an operation's summary and deprecated are errors at their pointer when of the wrong type" {
  let documents = [
    (
      #|{
      #|  "openapi": "3.1.0",
      #|  "paths": {
      #|    "/a": {
      #|      "get": { "summary": ["List"], "deprecated": "yes", "responses": { "200": {} } },
      #|      "put": { "summary": null, "deprecated": 1, "responses": { "200": {} } }
      #|    },
      #|    "/b/{id}": { "get": { "summary": 1, "deprecated": "no" } }
      #|  }
      #|}
    ),
  ]
  let rendered = []
  for document in documents {
    let yaml = import_to(document)
    assert_eq(import_to(document, output="defs/petstore.json"), yaml)
    rendered.push(yaml)
  }
  inspect(
    rendered.join(""),
    content=(
      #|petstore.json: /paths/~1a/get/summary: must be a string
      #|petstore.json: /paths/~1a/get/deprecated: must be true or false
      #|petstore.json: /paths/~1a/put/summary: must be a string
      #|petstore.json: /paths/~1a/put/deprecated: must be true or false
      #|petstore.json: /paths/~1b~1{id}/get/summary: must be a string
      #|petstore.json: /paths/~1b~1{id}/get/deprecated: must be true or false
      #|petstore.json: /paths/~1b~1{id}/get: warning: has no responses: the operation answers 200 with an empty body
      #|nothing written
      #|
    ),
  )
}

///|
test "values that would not read back as the same strings are quoted, in the file and nowhere in the comments" {
  let document =
    #|{
    #|  "openapi": "3.2.0",
    #|  "info": { "title": "\"Quoted\" #1: API", "version": "1.0" },
    #|  "paths": {
    #|    "/a: b": { "get": { "operationId": "list #1", "summary": "- [x] #1: done", "responses": { "200": {} } } },
    #|    "/'c'": { "additionalOperations": { "ON": { "operationId": "null", "responses": { "404": {} } } } }
    #|  }
    #|}
  let yaml = import_to(document, mock="yes")
  inspect(
    yaml,
    content=(
      #|2 Stubs from 2 operations
      #|# Generated by smock import-openapi from petstore.json
      #|# ("Quoted" #1: API 1.0, OpenAPI 3.2.0), with --mock yes.
      #|# Do not edit: the next import replaces this file.
      #|version: 1
      #|mocks:
      #|  - name: "yes"
      #|stubs:
      #|  # GET /a: b, 200: - [x] #1: done
      #|  - id: "yes.list #1.200"
      #|    mock: "yes"
      #|    request:
      #|      method: GET
      #|      path: "/a: b"
      #|    response:
      #|      status: 200
      #|  # ON /'c', 404
      #|  - id: yes.null.404
      #|    mock: "yes"
      #|    request:
      #|      method: "ON"
      #|      path: /'c'
      #|    response:
      #|      status: 404
      #|
    ),
  )
}
