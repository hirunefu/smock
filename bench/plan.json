{
  "about": "What bench/bench.py runs, all provisional until the first runs on the real path. Every case runs under every CPU limit, at the rate given for that limit, as one oha process per request of bench/requests.json at its weight's share of the rate and of the connections. Requests scheduled in the first ramp_s seconds (while connections open) are not counted, nor those after duration_s more; tail_s more seconds let the last counted requests finish. The targets are in bench/targets.json.",
  "load_generator": { "name": "oha", "version": "1.16.0" },
  "cpu_limits": ["250m", "500m", "1", "2"],
  "ramp_s": 2,
  "duration_s": 20,
  "tail_s": 3,
  "cooldown_s": 2,
  "rss_interval_s": 0.5,
  "cases": [
    {
      "name": "http-keep-alive",
      "protocol": "http",
      "connection": "keep-alive",
      "connections": 64,
      "rates": { "250m": 12500, "500m": 25000, "1": 50000, "2": 50000 }
    },
    {
      "name": "https-keep-alive",
      "protocol": "https",
      "connection": "keep-alive",
      "connections": 64,
      "rates": { "250m": 12500, "500m": 25000, "1": 50000, "2": 50000 }
    },
    {
      "name": "http-new-connection",
      "protocol": "http",
      "connection": "new-per-request",
      "connections": 64,
      "rates": { "250m": 1000, "500m": 2000, "1": 4000, "2": 4000 }
    },
    {
      "name": "https-new-connection",
      "protocol": "https",
      "connection": "new-per-request",
      "connections": 64,
      "rates": { "250m": 250, "500m": 500, "1": 1000, "2": 1000 }
    },
    {
      "name": "http-keep-alive-idle-connections",
      "protocol": "http",
      "connection": "keep-alive",
      "connections": 64,
      "idle_connections": 1000,
      "rates": { "250m": 12500, "500m": 25000, "1": 50000, "2": 50000 }
    }
  ],
  "long_run": {
    "name": "long-run",
    "protocol": "http",
    "connection": "keep-alive",
    "connections": 64,
    "cpu_limit": "1",
    "rate": 5000,
    "duration_s": 600,
    "rss_interval_s": 1
  },
  "idle_rss": { "cpu_limit": "1", "settle_s": 5 }
}
